<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Title>TestFramework.Azure</Title>
		<Version>0.5.0</Version>
		<Authors>DeadMoon0</Authors>
		<Product>TestFramework</Product>
		<Description>Interact with Azure infrastructure inside of a TestFramework Timeline.</Description>
		<PackageProjectUrl>https://github.com/DeadMoon0/TestFramework-Azure</PackageProjectUrl>
		<PackageIcon>Icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/DeadMoon0/TestFramework-Azure.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Test;UnitTest;IntegrationTest;Framework;Fluent;Timeline;Azure</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Copyright>Copyright (c) DeadMoon0 2026</Copyright>
		<PackageReleaseNotes>BREAKING - needs TestFramework.Core 0.7.0 and TestFramework.Config 0.4.0, and on net10.0 brings EF Core 10 instead of 8. services.LoadAzureConfigs() is renamed services.AddAzure(). MessageReceived(identifier) is narrowed with WithMessageId, WithCorrelationId, Where, CompleteMessage and WithTempSubscription; a Cosmos reference comes from CosmosRef(...); ISqlDbContextResolver.EnsureReadyAsync takes (RunContext, DbContext, SqlDatabaseIdentifier); AzureIsLiveResult.Success and ConfigurationValidationException are gone (catch FrameworkConfigurationException). An in-process Function App call now answers an object as camelCase JSON, as the host does, instead of its ToString(). Configuration records no longer print their credentials, an empty Function App Code means no key, and repeated AddSqlArtifactContexts calls add up. BREAKING - renamed so Azure and Web can be imported together: the SQL-row artifact types are AzureSqlRowArtifact*, the Function App HTTP builder actions are IFunctionApp*Action, and ConfigExtension is AzureConfigExtension. A Service Bus send no longer changes the caller&apos;s message, and its result is a frozen ServiceBusSentMessage instead of the live ServiceBusMessage. AzureEnvironmentResourceKinds is renamed AzureResourceKinds.</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>TestFramework.Azure.Tests</_Parameter1>
		</AssemblyAttribute>
		<!-- The only grant is the package's own test assembly. The container package used to reach
		     CosmosSchemaRestClient through a grant here; it now goes through the public CosmosSchema
		     facade, and the helper itself stays internal because it signs with the account master key. -->
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<PackageReference Include="Azure.Messaging.ServiceBus" Version="7.20.1" />
		<PackageReference Include="Azure.Data.Tables" Version="12.9.1" />
		<PackageReference Include="Azure.Storage.Blobs" Version="12.26.0" />
		<PackageReference Include="Microsoft.Azure.Cosmos" Version="3.59.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
		<PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.1.0" />
		<PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Timer" Version="4.3.1" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="TestFramework.Config" Version="0.4.0" />
		<PackageReference Include="TestFramework.Core" Version="0.7.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="$(PackageIconSourcePath)">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<!-- EF Core follows the framework: the major a consumer's runtime ships, so a net10.0 test project is not held
	     to EF Core 8 and a net8.0 one is not handed a major its runtime does not support. Pkcs is pinned above the
	     version the SqlClient under EF Core pulls in (8.0.1 / 9.0.4: GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.26" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.26" />
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
	</ItemGroup>

</Project>
