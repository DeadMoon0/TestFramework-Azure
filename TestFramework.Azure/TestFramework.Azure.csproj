<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Title>TestFramework.Azure</Title>
		<Version>0.5.0</Version>
		<Authors>DeadMoon0</Authors>
		<Product>TestFramework</Product>
		<Description>Interact with Azure infrastructure inside of a TestFramework Timeline.</Description>
		<PackageProjectUrl>https://github.com/DeadMoon0/TestFramework-Azure</PackageProjectUrl>
		<PackageIcon>Icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/DeadMoon0/TestFramework-Azure.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Test;UnitTest;IntegrationTest;Framework;Fluent;Timeline;Azure</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Copyright>Copyright (c) DeadMoon0 2026</Copyright>
		<PackageReleaseNotes>BREAKING - needs TestFramework.Core 0.7.0 and TestFramework.Config 0.4.0. MessageReceived(identifier) is narrowed with WithMessageId, WithCorrelationId, Where, CompleteMessage and WithTempSubscription instead of optional arguments; a Cosmos reference comes from CosmosRef(...), and setup refuses an item that is not the one its reference names. Optional parameters elsewhere became overloads, results are built by Azure only, AzureIsLiveResult.Success and GetSuccess are gone (a probe that does not answer fails), and the identifiers are sealed. The configuration records are sealed and print their credentials as (secret). A Function App Code that is absent or empty means no key: the call goes out without x-functions-key instead of failing. A missing setting is refused as FrameworkConfigurationException naming its full path; ConfigurationValidationException is gone, and FunctionAppPingException is a TimelineFrameworkException. A service provider holding Azure clients can now be disposed with a plain using. A Service Bus entry naming both a queue and a topic is refused, and a wait no longer fails on a transient error the processor retries. AddSqlArtifactContexts calls add up instead of the last one winning, and a second registration for one identifier or a second default is refused.</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>TestFramework.Azure.Tests</_Parameter1>
		</AssemblyAttribute>
		<!-- The only grant is the package's own test assembly. The container package used to reach
		     CosmosSchemaRestClient through a grant here; it now goes through the public CosmosSchema
		     facade, and the helper itself stays internal because it signs with the account master key. -->
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<PackageReference Include="Azure.Messaging.ServiceBus" Version="7.20.1" />
		<PackageReference Include="Azure.Data.Tables" Version="12.9.1" />
		<PackageReference Include="Azure.Storage.Blobs" Version="12.26.0" />
		<PackageReference Include="Microsoft.Azure.Cosmos" Version="3.59.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.26" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.26" />
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
		<PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.1.0" />
		<PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Timer" Version="4.3.1" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="TestFramework.Config" Version="0.4.0" />
		<PackageReference Include="TestFramework.Core" Version="0.7.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\Modules\TestFramework-Common\Assets\Icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Documentation\" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

</Project>
